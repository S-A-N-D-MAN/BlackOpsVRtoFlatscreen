    if(output_bytes)*output_bytes=0;if(!output||!output_bytes||index>=15||capacity_words<3)return false;
    output[0]=programs[index].vertex?0xfffe0300u:0xffff0300u;output[1]=0x10000000u+index;output[2]=0x0000ffffu;
    *output_bytes=12;return original_matches(index,output,*output_bytes);
}
