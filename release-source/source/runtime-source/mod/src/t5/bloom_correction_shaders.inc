constexpr bool metadata_valid() noexcept {
    for(const auto& p:programs){
        if(!p.original_bytes||!p.derivative_bytes||p.original_bytes%4||p.derivative_bytes%4||
           p.first_edit>sizeof(edits)/sizeof(edits[0])||p.edit_count>sizeof(edits)/sizeof(edits[0])-p.first_edit)return false;
        std::size_t cursor{},produced{};
        for(std::size_t i=0;i<p.edit_count;++i){const auto& e=edits[p.first_edit+i];
            if(e.original_word<cursor||e.original_word>p.original_bytes/4||e.removed_words>p.original_bytes/4-e.original_word||
               e.segment_id>=sizeof(segments)/sizeof(segments[0]))return false;
            const auto& segment=segments[e.segment_id];
            if(segment.first_word>sizeof(segment_words)/sizeof(segment_words[0])||
               segment.word_count>sizeof(segment_words)/sizeof(segment_words[0])-segment.first_word)return false;
            produced+=e.original_word-cursor+segment.word_count;cursor=e.original_word+e.removed_words;
        }
        if(produced+p.original_bytes/4-cursor!=p.derivative_bytes/4)return false;
    }
    return true;
}
static_assert(metadata_valid());
inline bool original_matches(unsigned index,const void* data,std::size_t bytes) noexcept {
    return index<sizeof(programs)/sizeof(programs[0])&&bytes==programs[index].original_bytes&&
        native_guard::matches(data,bytes,programs[index].original_sha256);
}
inline bool derivative_matches(unsigned index,const void* data,std::size_t bytes) noexcept {
    return index<sizeof(programs)/sizeof(programs[0])&&bytes==programs[index].derivative_bytes&&
        native_guard::matches(data,bytes,programs[index].derivative_sha256);
}
inline bool reconstruct(unsigned index,const std::uint32_t* original,std::size_t original_bytes,
                        std::uint32_t* output,std::size_t output_capacity_words,std::size_t* output_bytes) noexcept {
    if(output_bytes)*output_bytes=0;
    if(!output_bytes||!original||!output||index>=sizeof(programs)/sizeof(programs[0]))return false;
    const auto& p=programs[index];
    if(original_bytes!=p.original_bytes||output_capacity_words<p.derivative_bytes/4||
       !original_matches(index,original,original_bytes))return false;
    const std::size_t original_words=original_bytes/4;std::size_t cursor{},produced{};
    for(std::size_t i=0;i<p.edit_count;++i){const auto& e=edits[p.first_edit+i];
        const auto retained=static_cast<std::size_t>(e.original_word)-cursor;
        if(retained){std::memcpy(output+produced,original+cursor,retained*4);produced+=retained;}
        const auto& segment=segments[e.segment_id];
        if(segment.word_count){std::memcpy(output+produced,segment_words+segment.first_word,static_cast<std::size_t>(segment.word_count)*4);produced+=segment.word_count;}
        cursor=static_cast<std::size_t>(e.original_word)+e.removed_words;
    }
    if(cursor<original_words){const auto retained=original_words-cursor;std::memcpy(output+produced,original+cursor,retained*4);produced+=retained;}
    if(produced!=p.derivative_bytes/4||!derivative_matches(index,output,p.derivative_bytes))return false;
    *output_bytes=p.derivative_bytes;return true;
}
